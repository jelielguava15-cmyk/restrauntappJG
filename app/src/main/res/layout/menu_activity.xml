<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Restaurant Logo -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:src="@drawable/w3"
            android:scaleType="fitCenter"
            android:contentDescription="Restaurant Logo"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="America's Best Wings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FULL MENU"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/gray_text"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>

        <!-- Combos -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMBOS"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/red"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wings Combo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/dark_text"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fresh wings served with crispy fries."
                android:textSize="14sp"
                android:textColor="@color/gray_text"
                android:layout_marginTop="5dp"/>

        </LinearLayout>

        <!-- Quantity -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUANTITY"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/red"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="15dp">

                <Button
                    android:id="@+id/quantityMinus"
                    android:layout_width="55dp"
                    android:layout_height="50dp"
                    android:text="-"
                    android:textSize="23sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"/>

                <TextView
                    android:id="@+id/quantityText"
                    android:layout_width="75dp"
                    android:layout_height="50dp"
                    android:text="0"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/dark_text"/>

                <Button
                    android:id="@+id/quantityPlus"
                    android:layout_width="55dp"
                    android:layout_height="50dp"
                    android:text="+"
                    android:textSize="23sp"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/red"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Wing Type -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WING TYPE"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/red"/>

            <RadioGroup
                android:id="@+id/wingTypeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/flats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flats"
                    android:textColor="@color/dark_text"/>

                <RadioButton
                    android:id="@+id/drums"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drums"
                    android:textColor="@color/dark_text"/>

                <RadioButton
                    android:id="@+id/both"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Both"
                    android:textColor="@color/dark_text"/>

            </RadioGroup>
        </LinearLayout>

        <!-- Wing Size -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WING SIZE"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/red"/>

            <RadioGroup
                android:id="@+id/sizeGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/smallSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Small - $8.99"
                    android:textColor="@color/dark_text"/>

                <RadioButton
                    android:id="@+id/mediumSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medium - $11.99"
                    android:textColor="@color/dark_text"/>

                <RadioButton
                    android:id="@+id/largeSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Large - $14.99"
                    android:textColor="@color/dark_text"/>

            </RadioGroup>
        </LinearLayout>

        <!-- Sides -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIDES"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/red"/>

            <CheckBox
                android:id="@+id/friesCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="French Fries - $2.99"
                android:textSize="17sp"
                android:textColor="@color/dark_text"/>

        </LinearLayout>

        <!-- Drinks -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DRINKS"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/red"/>

            <CheckBox
                android:id="@+id/drinkCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Soft Drinks - $1.99"
                android:textSize="17sp"
                android:textColor="@color/dark_text"/>

        </LinearLayout>

        <!-- Checkout Button -->

        <Button
            android:id="@+id/checkoutButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="PROCEED TO CHECKOUT"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/red"
            android:layout_marginBottom="12dp"/>

        <!-- Back Button -->

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BACK TO HOME"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/dark_text"
            android:layout_marginBottom="15dp"/>

    </LinearLayout>

</ScrollView>

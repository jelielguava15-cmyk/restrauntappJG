<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:src="@drawable/w3"
            android:scaleType="fitCenter"
            android:contentDescription="America's Best Wings Logo" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="America's Best Wings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Call us: (603) 519-5949"
            android:textSize="17sp"
            android:textColor="@color/dark_text"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Popular Meals"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/dark_text"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@color/white"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wings and Fries"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fresh wings served with crispy fries."
                android:textSize="15sp"
                android:textColor="@color/gray_text"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:background="@color/white"
            android:layout_marginBottom="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chicken Tenders and Fries"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crispy chicken tenders served with fries."
                android:textSize="15sp"
                android:textColor="@color/gray_text"
                android:layout_marginTop="5dp" />

        </LinearLayout>

        <Button
            android:id="@+id/viewMenuButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="VIEW FULL MENU"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/red" />


    </LinearLayout>

</ScrollView>